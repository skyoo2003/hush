{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locite",
  "version": "0.1.0",
  "identifier": "io.github.skyoo2003.locite",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Locite",
        "url": "index.html",
        "width": 1080,
        "height": 720,
        "visible": false,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "settings",
        "title": "Locite",
        "url": "index.html",
        "width": 680,
        "height": 560,
        "minWidth": 680,
        "maxWidth": 680,
        "minHeight": 420,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 14
        },
        "maximizable": false
      },
      {
        "label": "quick-search",
        "title": "Locite",
        "url": "index.html",
        "width": 680,
        "height": 460,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; frame-ancestors 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/pdfium/LICENSE": "licenses/pdfium/LICENSE",
      "vendor/pdfium/licenses/": "licenses/pdfium/third_party/"
    },
    "macOS": {
      "frameworks": [
        "vendor/pdfium/lib/libpdfium.dylib"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwMkY3NTdCMEI5MjdCNEYKUldSUGU1SUxlM1V2a0tkK1hIajR1eTM2akZTQ0hKM3RwaG1qcCtNRkdLd0w5OG9KeHNsZUJRUjkK"
    }
  }
}
