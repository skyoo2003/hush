{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-search",
  "description": "Quick-search popup: search, open or reveal, and cite sources, index status, hide itself.",
  "windows": ["quick-search"],
  "permissions": [
    "allow-search",
    "allow-open-source",
    "allow-copy-citation",
    "allow-hide-window",
    "allow-get-index-status",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
