{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window: folders, index progress and schedule, settings, Air-Gap toggle, sponsor links and theme, models, update check and install, pack export.",
  "windows": ["main"],
  "permissions": [
    "allow-list-folders",
    "allow-add-watched-folder",
    "allow-remove-watched-folder",
    "allow-set-folder-enabled",
    "allow-list-failed-documents",
    "allow-retry-document",
    "allow-set-exclude-patterns",
    "allow-get-index-status",
    "allow-get-schedule",
    "allow-set-schedule",
    "allow-get-settings",
    "allow-set-air-gap",
    "allow-set-shortcut",
    "allow-set-supporter",
    "allow-set-theme",
    "allow-dismiss-sponsor-banner",
    "allow-open-sponsor",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-import-model-file",
    "allow-export-pack",
    "allow-check-for-update",
    "allow-install-update",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
