{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window: folders and index progress, settings, Air-Gap toggle, models, pack export.",
  "windows": ["main"],
  "permissions": [
    "allow-list-folders",
    "allow-add-watched-folder",
    "allow-remove-watched-folder",
    "allow-set-folder-enabled",
    "allow-list-failed-documents",
    "allow-retry-document",
    "allow-set-exclude-patterns",
    "allow-get-index-status",
    "allow-get-settings",
    "allow-set-air-gap",
    "allow-set-shortcut",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-import-model-file",
    "allow-export-pack",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
