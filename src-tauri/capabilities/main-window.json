{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main window (library): search and cite sources, folders and their failed files, index status, Air-Gap and theme read-only, sponsor banner, pack export, open Settings, menu context.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-search",
    "allow-open-source",
    "allow-copy-citation",
    "allow-list-folders",
    "allow-add-watched-folder",
    "allow-set-folder-enabled",
    "allow-list-failed-documents",
    "allow-retry-document",
    "allow-get-index-status",
    "allow-get-schedule",
    "allow-get-settings",
    "allow-get-appearance",
    "allow-dismiss-sponsor-banner",
    "allow-export-pack",
    "allow-open-settings",
    "allow-set-menu-context",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
